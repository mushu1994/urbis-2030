{
  "name": "urbis-2030",
  "version": "1.7.0",
  "private": true,
  "description": "URBIS 2030 — city builder isométrique pour navigateur (simulation urbaine, économie municipale, IA urbaine 2030).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench.js",
    "icons": "node scripts/make-icons.mjs",
    "balance": "node scripts/balance.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "android": "npm run build:android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
