# En-têtes HTTP (hébergement Netlify) : le service worker est toujours revérifié,
# les fichiers à nom haché sont mis en cache pour un an.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
